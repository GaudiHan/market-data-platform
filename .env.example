# Copy this file to .env and adjust if you want non-default local credentials.
# Nothing here is a real secret -- this all runs on your own machine via Docker.

TSDB_USER=mdp
TSDB_PASSWORD=mdp_local_pw
TSDB_DB=marketdata
TSDB_HOST=localhost
TSDB_PORT=5432

MONGO_USER=mdp
MONGO_PASSWORD=mdp_local_pw
MONGO_DB=marketdata
MONGO_HOST=localhost
MONGO_PORT=27017

# Symbols to stream, comma separated. Binance uses lowercase concatenated
# (btcusdt), Coinbase uses dashed uppercase (BTC-USD). The ingestion layer
# maps a common symbol like BTC-USD to each exchange's native format.
SYMBOLS=BTC-USD,ETH-USD

LOG_LEVEL=INFO

# Only used by the storage test suite (tests/correctness/test_timescale_writer.py,
# test_mongo_index_usage.py) to point at a scratch DB for integration tests.
# Defaults already match this file's TSDB_*/MONGO_* values -- override only
# if you're running Postgres/Mongo somewhere non-default.
# TEST_POSTGRES_DSN=postgresql://mdp:mdp_local_pw@localhost:5432/marketdata_test
# TEST_MONGO_URI=mongodb://mdp:mdp_local_pw@localhost:27017/?authSource=admin
